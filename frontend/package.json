{
  "name": "agent-kit-playground",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:openapi": "../.venv/bin/python ../scripts/dump_openapi.py",
    "gen:types": "npm run gen:openapi && openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
