# agent-kit reads plain environment variables; it does not load a .env file
# itself. Export these in your shell (or `set -a; source .env; set +a`).
# Everything is optional. Most can also be changed at runtime in the Settings screen.

# Set to 1 to return registered fixtures and make no model calls (offline demo, tests).
STUB_AI_PROVIDERS=

# OpenAI-compatible endpoint that local models resolve to (default: local Ollama).
AGENT_KIT_PROVIDER_URL=

# Model the Game Master uses for trait synthesis (default: qwen2.5:14b).
AGENT_KIT_GM_MODEL=

# Game Master provider: ollama (default), anthropic or openai.
AGENT_KIT_GM_PROVIDER=

# API key for the Game Master when its provider is not ollama.
AGENT_KIT_GM_API_KEY=

# Output-validation retries for the Game Master (default 4).
AGENT_KIT_GM_RETRIES=

# SQLite file for agent cards, XP and traits (default: agent_kit.db).
AGENT_KIT_DB_PATH=

# Directory for generated agents, settings.json and sample inputs (default: agent_kit_data).
AGENT_KIT_DATA_DIR=

# ntfy endpoint for best-effort push notifications; unset disables them.
NTFY_URL=

# Used by dev.sh / backend.sh: address the API binds to (default 127.0.0.1:8000).
AGENT_KIT_HOST=
AGENT_KIT_PORT=

# Used by the Vite dev server: where to proxy /api (default http://127.0.0.1:8000).
AGENT_KIT_API=
